{
  "name": "assesments",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w packages/web",
    "dev:api": "npm run dev -w packages/api",
    "test": "npm run test --workspaces --if-present"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true,
    "prisma@7.10.0": true,
    "@prisma/engines@7.10.0": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
