generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  ADMIN
}

enum Frequency {
  ANNUAL
  SEMI_ANNUAL
  MONTHLY
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

model User {
  id           String   @id @default(uuid())
  emailHash    String   @unique
  emailEnc     Bytes
  passwordHash String
  nameEnc      Bytes
  dobEnc       Bytes
  mobileEnc    Bytes
  nameInitial  String   @db.VarChar(1)
  mobileLast4  String   @db.VarChar(4)
  role         Role     @default(CUSTOMER)
  tokenVersion Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  illustrations Illustration[]
  auditLogs     AuditLog[]
}

model PolicyType {
  id             String   @id @default(uuid())
  code           String   @unique
  name           String
  description    String
  minAge         Int
  maxAge         Int
  minTerm        Int
  maxTerm        Int
  minPremiumTerm     Int
  maxPremiumTerm     Int
  minPremium         Decimal  @db.Decimal(15, 2)
  maxPremium         Decimal  @db.Decimal(15, 2)
  sumAssuredMultiple Decimal  @db.Decimal(8, 4)
  sumAssuredCap      Decimal  @db.Decimal(15, 2)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())

  premiumOptions PremiumOption[]
  rateTables     RateTable[]
  illustrations  Illustration[]
}

model PremiumOption {
  id                 String     @id @default(uuid())
  policyTypeId       String
  policyType         PolicyType @relation(fields: [policyTypeId], references: [id], onDelete: Cascade)
  frequency          Frequency
  instalmentsPerYear Int

  @@unique([policyTypeId, frequency])
}

model RateTable {
  id            String     @id @default(uuid())
  policyTypeId  String
  policyType    PolicyType @relation(fields: [policyTypeId], references: [id], onDelete: Cascade)
  version       String
  effectiveFrom DateTime   @db.Date
  isActive      Boolean    @default(false)
  assumptions   Json
  createdAt     DateTime   @default(now())

  @@unique([policyTypeId, version])
}

model Illustration {
  id              String     @id @default(uuid())
  userId          String
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  policyTypeId    String
  policyType      PolicyType @relation(fields: [policyTypeId], references: [id])
  dobEnc          Bytes
  gender          Gender
  sumAssured      Decimal    @db.Decimal(15, 2)
  modalPremium    Decimal    @db.Decimal(15, 2)
  policyTerm      Int
  premiumTerm     Int
  frequency       Frequency
  asOfDate        DateTime   @db.Date
  rateVersion     String
  entryAge        Int
  totalPremium    Decimal    @db.Decimal(15, 2)
  maturityBenefit Decimal    @db.Decimal(15, 2)
  irr             Decimal?   @db.Decimal(9, 6)
  createdAt       DateTime   @default(now())

  @@index([userId, createdAt])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  ipHash    String?
  metadata  Json     @default("{}")
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([action, createdAt])
}
