# Copy to .env for local development:  cp .env.example .env
# .env is gitignored. Never commit real values. See README "Secrets management".

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Postgres from docker-compose.yml (port 5433 on the host).
DATABASE_URL=postgresql://bi_app:devonly@localhost:5433/benefit_illustration?schema=public

# Origin the browser app is served from, for CORS.
WEB_ORIGIN=http://localhost:5173

# Dates like "age today" are computed in the business's timezone, not the server's.
BUSINESS_TIMEZONE=Asia/Kolkata

# JWT signing secrets, at least 32 characters each, different from each other.
# Generate with:  openssl rand -base64 48
JWT_ACCESS_SECRET=replace-me-with-openssl-rand-base64-48-output-1
JWT_REFRESH_SECRET=replace-me-with-openssl-rand-base64-48-output-2

# Field-level encryption keys for PII (AES-256-GCM), as "version:base64key" pairs.
# Each key is 32 random bytes:  openssl rand -base64 32
# To rotate: add a new version, point PII_ACTIVE_KEY_VERSION at it, run the re-encrypt job,
# then remove the old version.
PII_ENCRYPTION_KEYS=1:REPLACE_WITH_openssl_rand_base64_32
PII_ACTIVE_KEY_VERSION=1

# HMAC key for the email lookup hash (lets login find a user without storing email in clear).
# openssl rand -base64 32
PII_HMAC_KEY=REPLACE_WITH_openssl_rand_base64_32
